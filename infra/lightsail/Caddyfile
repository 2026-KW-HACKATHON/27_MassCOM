{
	admin off
}

{$MASSCOM_API_DOMAIN:api.masscom.kr} {
	encode zstd gzip
	reverse_proxy api:3000 {
		# The API trusts this single value for login throttling; never pass a client-supplied chain.
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}

{$MASSCOM_SHOWCASE_API_DOMAIN:demo-api.masscom.kr} {
	encode zstd gzip
	reverse_proxy showcase-api:3000 {
		# Only Caddy's observed client IP may drive the invited-login rate limit.
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}

{$MASSCOM_WEB_DOMAIN:masscom.kr} {
	encode zstd gzip
	root * /srv/masscom

	@appRoot path /app
	redir @appRoot /app/ 308
	@adminRoot path /admin
	redir @adminRoot /admin/ 308
	@merchantRoot path /merchant
	redir @merchantRoot /merchant/ 308
	@previewRoot path /preview
	redir @previewRoot /preview/ 308
	@webSession path /api/web/auth/start /api/web/auth/callback /api/web/logout /api/web/collection /api/web/badges /api/web/admin/* /api/web/merchant/* /api/web/account-deletion-intake /api/web/account-deletion-intake/cancel /api/web/account-deletion-status
	handle @webSession {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	# 발행 확정 때 고정한 NFT 메타데이터·그림(Issue #254)은 API가 준다. 읽기만, 정해진 모양의 경로만 넘긴다.
	# 컨트랙트에 고정된 실증 토큰(base-sepolia-proof)은 지금처럼 정적 파일로 남긴다.
	@nftMetadataApi {
		method GET HEAD
		path_regexp ^/nft-metadata/(images/[0-9a-f]{64}\.webp|[A-Za-z0-9][A-Za-z0-9_-]{0,127}/(0|[1-9][0-9]{0,77})\.json)$
		not path /nft-metadata/base-sepolia-proof/*
	}
	handle @nftMetadataApi {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle_path /app/* {
		reverse_proxy production-web:4173
	}
	handle /admin/* {
		reverse_proxy production-web:4173
	}
	handle /merchant/* {
		reverse_proxy production-web:4173
	}
	handle /merchants {
		reverse_proxy production-web:4173
	}
	@open path /open
	rewrite @open /open.html
	@privacy path /privacy
	rewrite @privacy /privacy.html
	@deletion path /account-deletion
	rewrite @deletion /account-deletion.html
	handle {
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	@privateSurface path /admin/* /merchant/* /api/web/admin/* /api/web/merchant/* /api/web/account-deletion-intake /api/web/account-deletion-intake/cancel /api/web/account-deletion-status
	header @privateSurface {
		Cache-Control "no-store"
		X-Robots-Tag "noindex, nofollow"
	}
	# Token metadata is public and its URL is fixed on-chain; browser wallets and explorers read it cross-origin.
	# Deferred so it replaces (not duplicates) the value the API already sends for proxied metadata.
	header /nft-metadata/* {
		Access-Control-Allow-Origin "*"
		defer
	}
}
