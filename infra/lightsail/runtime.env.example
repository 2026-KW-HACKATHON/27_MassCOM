# Copy this file outside the repository and replace every placeholder.
# Never commit the real runtime file.
MASSCOM_API_DOMAIN=api.masscom.kr
MASSCOM_IMAGE_TAG=local
POSTGRES_PASSWORD=
GOOGLE_OAUTH_CLIENT_IDS=
# Enable all three only after registering https://masscom.kr/api/web/auth/callback with Google.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_WEB_REDIRECT_URI=
# Set true only after the exact www.masscom.kr callback is registered with Google.
GOOGLE_WEB_WWW_ENABLED=false
ACCOUNT_DELETION_HMAC_SECRET=
MERCHANT_REFERENCE_HMAC_SECRET=
# 서버 전용 TMAP REST 키. 수정 후 API 컨테이너를 재생성해야 적용됩니다.
TMAP_REST_APP_KEY=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# 사장님 AI 가게 그림(D-048). 비워 두면 기능이 꺼진다(다른 기능에는 영향 없음). 키는 소유자가 이 파일에만 직접 넣는다.
OPENAI_API_KEY=
# 아래는 필요할 때만 주석을 풀어 바꾼다(비우면 기본값). 예산은 운영 DB 기준 한국 달 합계(USD)다.
# AI_ART_MONTHLY_BUDGET_USD=5
# AI_ART_DAILY_DRAFT_ROUNDS=3
# AI_ART_DAILY_FINALS=3
# AI_ART_DRAFT_MODEL=gpt-image-2.5-flare
# AI_ART_FINAL_MODEL=gpt-image-2.5-sunburst
