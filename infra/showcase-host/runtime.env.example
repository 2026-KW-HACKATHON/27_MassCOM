# Copy outside Git with file mode 600. Leave real values out of the repository.
MASSCOM_SHOWCASE_IMAGE_TAG=local
SHOWCASE_HOST_POSTGRES_PASSWORD=
SHOWCASE_GOOGLE_WEB_CLIENT_ID=
SHOWCASE_INVITED_SUBJECT_SHA256=
SHOWCASE_STAFF_SUBJECT_SHA256=
SHOWCASE_ACCOUNT_DELETION_HMAC_SECRET=
SHOWCASE_MERCHANT_REFERENCE_HMAC_SECRET=
# 시연 서버 전용 TMAP REST 키. 수정 후 showcase-api 컨테이너를 재생성해야 적용됩니다.
TMAP_REST_APP_KEY=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# 사장님 AI 가게 그림(D-048). 비워 두면 기능이 꺼진다. 키는 소유자가 서버의 runtime.env에만 직접 넣는다(컨테이너에는 OPENAI_API_KEY로 전달).
# 키를 넣거나 지운 뒤에는 서버에서 `sudo bash enable-ai-art.sh enable|disable`로 showcase-api만 다시 만든다(README의 켜는 순서, D-058). 월 예산 USD 5는 기본값이다.
# 키 줄은 정확히 `SHOWCASE_OPENAI_API_KEY=<값>` 한 줄이어야 한다(export·들여쓰기·공백·콜론·중복·`$`·비ASCII 금지, 값은 A-Z a-z 0-9 . _ : ~ + / = - 만). 다르게 쓰면 enable-ai-art.sh가 거절한다.
SHOWCASE_OPENAI_API_KEY=
# 아래는 필요할 때만 주석을 풀어 바꾼다(비우면 기본값). 예산은 시연 DB 기준 한국 달 합계(USD)다.
# SHOWCASE_AI_ART_MONTHLY_BUDGET_USD=5
# SHOWCASE_AI_ART_DAILY_DRAFT_ROUNDS=3
# SHOWCASE_AI_ART_DAILY_FINALS=3
# SHOWCASE_AI_ART_DRAFT_MODEL=gpt-image-2.5-flare
# SHOWCASE_AI_ART_FINAL_MODEL=gpt-image-2.5-sunburst
