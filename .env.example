# Copy to a local .env file and fill only the values needed for your environment.
# Never commit private keys, recovery phrases, access tokens, real QR secrets, or personal data.

APP_ENV=
API_BASE_URL=
API_BIND_HOST=127.0.0.1
DATABASE_URL=
# At least 32 random bytes. Used only to HMAC merchant order references.
MERCHANT_REFERENCE_HMAC_SECRET=
# At least 32 random bytes. Used to derive deleted-account references; never reuse another HMAC secret.
ACCOUNT_DELETION_HMAC_SECRET=
ACCOUNT_DELETION_POLICY_VERSION=account-deletion-v1
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_IDS=
AUTH_SESSION_TTL_MS=2592000000
GOOGLE_JWKS_MAX_STALE_MS=86400000
AUTH_SESSION_CLEANUP_BATCH_SIZE=100
AUTH_LOGIN_RATE_LIMIT_MAX=60
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000
REOWN_PROJECT_ID=
EXPO_PUBLIC_REOWN_PROJECT_ID=
EXPO_PUBLIC_API_URL=
# TMAP SDK client identifier (public in the app bundle); use a separate environment-specific app.
EXPO_PUBLIC_TMAP_MAP_APP_KEY=
# Server REST credential. Leave empty to keep external place and walking-route requests unavailable.
TMAP_REST_APP_KEY=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
EXPO_PUBLIC_DEMO_ACCOUNT_ID=
EXPO_PUBLIC_DEMO_MERCHANT_ACCOUNT_ID=
EXPO_PUBLIC_DEMO_MERCHANT_ID=
EXPO_PUBLIC_ALLOW_INSECURE_DEMO_REAUTHENTICATION=false
WALLET_REDIRECT_URI=
SIWE_DOMAIN=
SIWE_URI=
CHAIN_ID=
CHAIN_RPC_URL=
NFT_CONTRACT_ADDRESS=
NFT_MINT_CONSENT_VERSION=nft-mint-v2
MINTER_KEY_REFERENCE=
MINTER_ADDRESS=
CHAIN_CONFIRMATIONS=
CHAIN_FROM_BLOCK=
CHAIN_REORG_MARGIN=
# 민터 잔액이 이 값(wei) 이하이면 신규 전송을 미루고 재시도한다. 비우면 0.
MINTER_MIN_BALANCE_WEI=
MINTER_MAX_TX_FEE_WEI=10000000000000000
MINTER_LOCK_TIMEOUT_MS=10000
WORKER_DATABASE_POOL_MAX=4
WORKER_ID=
# NFT 메타데이터·그림 공개 출처(필수, 기본값 없음). 로컬 http://127.0.0.1:3000, 운영 https://masscom.kr, 시연 https://demo-api.masscom.kr.
# 온체인 createSeries의 baseTokenURI는 <출처>/nft-metadata/<nft_series.id>/여야 한다(Issue #254).
NFT_METADATA_ORIGIN=
# Local Anvil only. Production-like chains must never enable this.
ALLOW_UNLOCKED_LOCAL_MINTER=false
IPFS_GATEWAY_URL=
WALLET_CHALLENGE_TTL_MS=
# "production" builds the store Android app (kr.masscom.wolgye); anything else builds the dev app.
APP_VARIANT=
BASE_SEPOLIA_ADMIN=
BASE_SEPOLIA_MINTER=
BASE_SEPOLIA_PAUSER=
# Optional; defaults to https://sepolia.base.org when unset.
BASE_SEPOLIA_RPC_URL=
