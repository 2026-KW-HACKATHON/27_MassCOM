{
  "name": "@masscom/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/postgres/migrate-command.ts",
    "db:migrate:local": "tsx --env-file=.env src/postgres/migrate-command.ts",
    "db:migrate:production": "node dist/postgres/migrate-command.js",
    "admin:role": "tsx src/postgres/admin-role-command.ts",
    "admin:role:production": "node dist/postgres/admin-role-command.js",
    "admin:deletion": "tsx src/postgres/account-deletion-command.ts",
    "admin:deletion:host": "node dist/postgres/account-deletion-command.js",
    "admin:retention": "tsx src/postgres/retention-command.ts",
    "admin:retention:host": "node dist/postgres/retention-command.js",
    "seed:showcase:local": "tsx src/showcase/seed-command.ts",
    "seed:showcase:host": "tsx src/showcase/host-seed-command.ts",
    "grant:showcase:staff": "tsx src/showcase/grant-staff-command.ts",
    "grant:showcase:approver": "tsx src/showcase/grant-approver-command.ts",
    "start": "tsx src/server.ts",
    "start:local": "tsx --env-file=.env src/server.ts",
    "start:production": "node dist/server.js",
    "test": "tsx --test 'src/**/*.test.ts'",
    "test:postgres": "tsx --test --test-concurrency=1 'src/**/*.postgres.integration.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "pg": "8.23.0",
    "qrcode": "1.5.3",
    "siwe": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.18.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
