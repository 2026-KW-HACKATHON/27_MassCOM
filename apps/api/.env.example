PORT=3000
SIWE_DOMAIN=api.masscom.local
SIWE_URI=https://api.masscom.local/wallet/verify
WALLET_CHAIN_ID=84532
WALLET_CHALLENGE_TTL_MS=300000
ALLOW_INSECURE_DEMO_ACCOUNT=false
DATABASE_URL=
# FCM HTTP v1. 서버 환경에만 넣고 앱·Git·로그에 서비스 계정 키를 넣지 않습니다.
# 세 값이 모두 없으면 앱 안 알림함은 동작하고 기기 발송은 보류됩니다.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
NFT_MINT_CONSENT_VERSION=nft-mint-v2
# 32바이트 이상. 점포 주문 참조 HMAC에만 사용하며 실제 값은 커밋하지 않습니다.
MERCHANT_REFERENCE_HMAC_SECRET=
# 32바이트 이상. 삭제 원계정 ID를 보관하지 않는 HMAC 참조 생성 전용입니다.
ACCOUNT_DELETION_HMAC_SECRET=
ACCOUNT_DELETION_POLICY_VERSION=account-deletion-v1
# 쉼표로 구분한 Google OAuth client id 목록. DATABASE_URL과 함께 설정하면 운영 로그인이 켜지며
# ALLOW_INSECURE_DEMO_ACCOUNT=true와 동시에 설정하면 기동을 거부합니다.
GOOGLE_OAUTH_CLIENT_IDS=
AUTH_SESSION_TTL_MS=2592000000
# Google JWKS 조회 실패 때 마지막 정상 키를 허용할 최대 시간(10분~7일).
GOOGLE_JWKS_MAX_STALE_MS=86400000
# 성공 로그인 한 번에 지울 만료·폐기 세션 상한.
AUTH_SESSION_CLEANUP_BATCH_SIZE=100
# /auth/google의 socket 원격 주소별 fixed-window 제한. X-Forwarded-For는 신뢰하지 않습니다.
AUTH_LOGIN_RATE_LIMIT_MAX=60
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000
# 사장님 AI 가게 그림(D-048). OPENAI_API_KEY가 비어 있으면 기능이 꺼진다. 키는 실제 값을 커밋하지 않는다.
OPENAI_API_KEY=
# 로컬 시험은 `node scripts/fake-openai-images.mjs`(가짜 이미지 서버)로 키 없이 전체 흐름을 확인할 수 있다.
# AI_ART_OPENAI_BASE_URL=http://127.0.0.1:4010
# MANAGE_ART는 기본으로 OWNER만이다. 로컬 시험에서 STAFF 계정으로 열려면 켠다(시연 compose만 true, 운영은 설정하지 않는다).
# AI_ART_STAFF_MAY_MANAGE=true
# AI_ART_MONTHLY_BUDGET_USD=5
# AI_ART_DAILY_DRAFT_ROUNDS=3
# AI_ART_DAILY_FINALS=3
