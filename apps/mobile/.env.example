EXPO_PUBLIC_REOWN_PROJECT_ID=
# TMAP 지도 SDK용 공개 앱 식별 키. 빌드에 포함되므로 서버 전용 REST 키를 복사하지 않습니다.
# showcase 빌드는 EXPO_NO_DOTENV=1이므로 별도 환경에서 이 값을 export해야 합니다.
EXPO_PUBLIC_TMAP_MAP_APP_KEY=
# NAVER Cloud Maps 공개 Client ID. Secret은 앱에 넣지 않습니다.
# 콘솔에 Web Dynamic Map URL과 각 Mobile Dynamic Map Android package를 등록해야 합니다.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
# Showcase builds use EXPO_NO_DOTENV=1; export this dedicated public 32-hex project ID separately.
# Do not copy the production Reown ID.
MASSCOM_SHOWCASE_REOWN_PROJECT_ID=
# The values below are for APP_VARIANT=development only. Showcase rejects them.
# Public OAuth client identifier used as the server ID-token audience; never put a client secret here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Development default only; production requires a non-loopback HTTPS URL.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
# 선택적 Android FCM 설정: 해당 variant package와 일치하는 파일의 절대 경로.
# 서비스 계정 PEM 키는 이 파일에 넣지 않습니다. 알림함은 이 설정 없이도 동작합니다.
MASSCOM_FIREBASE_GOOGLE_SERVICES_FILE=
# Development only. Production builds must leave all DEMO identity variables unset.
EXPO_PUBLIC_DEMO_ACCOUNT_ID=local-demo-user
EXPO_PUBLIC_DEMO_MERCHANT_ACCOUNT_ID=local-demo-staff
EXPO_PUBLIC_DEMO_MERCHANT_ID=local-demo-merchant
# Development only. Production must leave this unset; even "false" is rejected.
EXPO_PUBLIC_ALLOW_INSECURE_DEMO_REAUTHENTICATION=false
